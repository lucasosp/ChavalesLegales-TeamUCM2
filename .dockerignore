# VCS and toolchain state
.git
.gitignore
.gitattributes

# Node/Python build output, regenerated inside the images
**/node_modules/
**/.next/
**/__pycache__/
**/venv/
**/.venv/

# Built novel is generated by the frontend build (prepare-novel.mjs)
frontend/public/novela/

# App runtime state, lives in the datathon-data volume
backend/telemetry_data.json
backend/telemetry_drawings.json
backend/casos_data.json

# Environment files: configuration comes from compose, never from an image.
.env
.env.*

# NOTE: images/ and fotoss/ are NOT excluded. The frontend build needs them:
# LegalinStory/src/content/{characterImages,backgroundImages}.js import them
# with new URL("../../../images/...", import.meta.url), i.e. from the repo
# root, and Vite hashes them into frontend/public/novela/assets. Excluding
# them here makes every portrait and background 404 in production.

# Not needed to build the images
devenv.*
.direnv
*.md
start.ps1
start.bat
ecosystem.config.js

# Deploy bookkeeping, and anything a rootless podman store might drop here:
# a .local/.config/.cache inside the context makes `compose build` fail with
# "can't stat .../storage/overlay/...".
.deployed-rev
.local
.config
.cache
