# Production settings for compose.prod.yml.
# Copy to .env.prod (git-ignored), then:
#
#   docker compose --env-file .env.prod -f compose.prod.yml up -d --build
#
# This app needs no secrets: there is no database and no signing key.

# Public address Caddy serves. Behind the Cloudflare tunnel keep ":80"
# (the tunnel's public hostname terminates TLS and forwards to Caddy).
SITE_ADDRESS=:80

# CORS allow-list for the API (comma separated). Same-origin traffic through
# Caddy does not need it, but it makes direct API use from the public domain
# work. Use * during testing.
ALLOWED_ORIGINS=https://datathon.tetegrid.dev
